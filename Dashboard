      const days=Math.round((Date.parse(r.eol)-Date.parse(d))/DAY);
      return days<=365 ? 'Ending within 12 months' : 'Supported';
    }
    return r.src==='Supported' ? 'Supported (no EOL date)' : 'Unsupported (no EOL date)';
  }
  const $=id=>document.getElementById(id);
  const PRODS=[...new Set(PIT.map(r=>r.os))].sort((a,b)=>a.localeCompare(b));
  $('pitOS').innerHTML='<option value="">All products</option>'+PRODS.map(o=>`<option>${esc(o)}</option>`).join('');
  $('pitStatus').innerHTML='<option value="">All statuses</option>'+ORDER.map(s=>`<option>${esc(s)}</option>`).join('');
  function fmtDate(iso){ if(!iso) return ''; const [y,m,d]=iso.split('-'); const M=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];return `${+d} ${M[+m-1]} ${y}`; }
  function render(){
    const d=$('pitDate').value;
    if(!d){ $('pitCount').textContent='Select a date.'; return; }
    const os=$('pitOS').value, st=$('pitStatus').value, term=$('pitSearch').value.trim().toLowerCase();
    const all=PIT.map(r=>({r,s:statusAt(r,d)}));
    const counts={}; ORDER.forEach(s=>counts[s]=0);
    all.forEach(x=>counts[x.s]++);
    $('pitKpis').innerHTML=ORDER.map(s=>`<div class="pit-kpi"><b>${counts[s]}</b><span><span class="pill ${CL[s]}">&nbsp;</span> ${esc(s)}</span></div>`).join('');
    const items=all.filter(x=>(!os||x.r.os===os)&&(!st||x.s===st)&&(!term||(x.r.os+' '+x.r.cycle+' '+x.r.codename).toLowerCase().includes(term)));
    $('pitCount').textContent=`Status on ${fmtDate(d)}: showing ${items.length} of ${PIT.length} release cycles`;
    $('pitBody').innerHTML=items.map(x=>`<tr><td>${esc(x.r.os)}</td><td>${esc(x.r.cycle)}</td><td>${esc(x.r.codename)}</td><td>${esc(x.r.releaseTxt)}</td><td>${esc(x.r.eolTxt)}</td><td>${esc(x.r.extTxt)}</td><td><span class="pill ${CL[x.s]}">${esc(x.s)}</span></td></tr>`).join('') || '<tr><td colspan="7" class="muted">No cycles match these filters.</td></tr>';
  }
  ['pitDate','pitOS','pitStatus'].forEach(id=>$(id).addEventListener('change',render));
  $('pitSearch').addEventListener('input',render);
  $('pitReset').addEventListener('click',()=>{ $('pitDate').value='2026-10-20'; render(); });
  render();
})();
</script>
<!--PIT-END-->
</body></html>
