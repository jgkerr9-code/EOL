$('thead').innerHTML=COLS.map(([k,l])=>`<th tabindex="0" data-k="${k}" aria-sort="none">${l} <span class="ar"></span></th>`).join('');
function sortVal(r,k){if(k==='eol'||k==='support'||k==='release'||k==='ext'){return r[k]?new Date(r[k]).getTime()||0:-Infinity;}return (r[k]==null?"":String(r[k])).toLowerCase();}
function doSort(k){if(sortKey===k)sortDir=-sortDir;else{sortKey=k;sortDir=1;}renderE();}
document.querySelectorAll('#thead th').forEach(th=>{const go=()=>doSort(th.dataset.k);th.addEventListener('click',go);th.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go();}});});
function renderE(){
  const term=$('eSearch').value.trim().toLowerCase(),os=$('eOS').value,st=$('eStatus').value;
  let items=ROWS.filter(r=>(!os||r.os===os)&&(!st||r.status===st)&&(!term||(r.os+' '+r.cycle+' '+(r.codename||'')+' '+(r.latest||'')).toLowerCase().includes(term)));
  if(sortKey){items=items.slice().sort((a,b)=>{const x=sortVal(a,sortKey),y=sortVal(b,sortKey);return (x<y?-1:x>y?1:0)*sortDir;});}
  document.querySelectorAll('#thead th').forEach(th=>{const on=th.dataset.k===sortKey;th.setAttribute('aria-sort',on?(sortDir>0?'ascending':'descending'):'none');th.querySelector('.ar').textContent=on?(sortDir>0?'▲':'▼'):'';});
  const pages=Math.max(1,Math.ceil(items.length/PER));if(page>=pages)page=pages-1;
  const slice=items.slice(page*PER,page*PER+PER);
  $('tbody').innerHTML=slice.map(r=>`<tr><td>${esc(r.os)}</td><td>${esc(r.cycle)}</td><td>${esc(r.codename||'')}</td><td>${esc(r.release||'')}</td><td>${esc(r.support||'')}</td><td>${esc(r.eol||'')}</td><td>${esc(r.ext||'')}</td><td>${esc(r.latest||'')}</td><td><span class="pill ${CLS[r.status]}">${esc(r.status)}</span></td></tr>`).join('')||'<tr><td colspan="9" class="muted">No cycles match these filters.</td></tr>';
  $('pinfo').textContent=`Page ${page+1} of ${pages}`;$('prev').disabled=page<=0;$('next').disabled=page>=pages-1;
  $('ecount').textContent=`${items.length} of ${ROWS.length} cycles shown`;
}
['eOS','eStatus'].forEach(id=>$(id).addEventListener('change',()=>{page=0;renderE();}));
$('eSearch').addEventListener('input',()=>{page=0;renderE();});
$('prev').addEventListener('click',()=>{page--;renderE();});$('next').addEventListener('click',()=>{page++;renderE();});
renderE();
// ending soon
const soon=ROWS.filter(r=>r.status==="Ending within 12 months").sort((a,b)=>(a.eol_iso||'').localeCompare(b.eol_iso||''));
$('soonBody').innerHTML=soon.length?soon.map(r=>`<tr><td>${esc(r.os)}</td><td>${esc(r.cycle)}</td><td>${esc(r.codename||'')}</td><td>${esc(r.support||'')}</td><td>${esc(r.eol||'')}</td><td>${esc(r.latest||'')}</td></tr>`).join(''):'<tr><td colspan="6" class="muted">None.</td></tr>';
</script>
