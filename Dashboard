<script>
(function(){
  const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const OSES=[...new Set(ROWS.map(r=>r.os))].sort((a,b)=>a.localeCompare(b));
  const grid=document.getElementById('bpGrid');
  function openCycles(os){
    tab('ex');
    document.getElementById('eOS').value=os;
    document.getElementById('eSearch').value='';
    document.getElementById('eStatus').value='';
    page=0; renderE();
  }
  function render(){
    const term=document.getElementById('bpSearch').value.trim().toLowerCase();
    grid.innerHTML='';
    OSES.filter(o=>!term||o.toLowerCase().includes(term)).forEach(os=>{
      const rs=ROWS.filter(r=>r.os===os);
      const card=document.createElement('div');
      card.className='bp-card';
      card.innerHTML=`<h4>${esc(os)}</h4><div class="bp-meta">${rs.length} cycle${rs.length>1?'s':''}</div><div class="bp-chips"></div>`;
      const chips=card.querySelector('.bp-chips');
      rs.forEach(r=>{
        const b=document.createElement('button');
        b.type='button'; b.className='bp-chip';
        b.title=r.status+(r.eol?' | EOL '+r.eol:'');
        b.setAttribute('aria-label',`${os} ${r.cycle}: ${r.status}`);
        b.innerHTML=`<span class="pill ${CLS[r.status]}">&nbsp;</span>${esc(r.cycle)}`;
        b.addEventListener('click',()=>openCycles(os));
        chips.appendChild(b);
      });
      grid.appendChild(card);
    });
    if(!grid.children.length){grid.innerHTML='<p class="muted">No products match this search.</p>';}
  }
  document.getElementById('bpSearch').addEventListener('input',render);
  render();
})();
</script>
