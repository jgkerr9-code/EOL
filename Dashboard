<!DOCTYPE html>
<html lang="en-GB"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>All Versions Lifecycle Dashboard</title>
<style>
:root{--ink:#1d2433;--mut:#5b6474;--line:#dfe3ea;--bg:#f6f7f9;--card:#fff;--acc:#1f5fa8;--S:#2e7d4f;--N:#4f8f6a;--E:#c77a12;--EX:#7a5fb0;--X:#b3261e;--U:#8a919e}
*{box-sizing:border-box}body{margin:0;font-family:Inter,"Segoe UI",Roboto,Arial,sans-serif;background:var(--bg);color:var(--ink);font-size:15px;line-height:1.5}
header{background:var(--ink);color:#fff;padding:22px 28px}header h1{margin:0;font-size:22px}header p{margin:4px 0 0;color:#c9d1de;font-size:13px}
nav{display:flex;gap:4px;flex-wrap:wrap;background:#fff;border-bottom:1px solid var(--line);padding:0 20px;position:sticky;top:0;z-index:5}
nav button{background:none;border:0;border-bottom:3px solid transparent;padding:14px 14px;font:inherit;color:var(--mut);cursor:pointer}
nav button[aria-selected=true]{color:var(--acc);border-color:var(--acc);font-weight:600}
nav button:focus-visible,select:focus-visible,input:focus-visible,button:focus-visible,th:focus-visible{outline:3px solid #9ec3ef;outline-offset:2px}
main{max-width:1200px;margin:0 auto;padding:24px 20px 40px}
section{display:none}section.on{display:block}
h2{font-size:18px;margin:0 0 6px}.sub{color:var(--mut);margin:0 0 18px;font-size:14px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:18px}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px}.kpi b{display:block;font-size:26px}.kpi span{color:var(--mut);font-size:13px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}@media(max-width:800px){.grid2{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px}
.bar{display:grid;grid-template-columns:200px 1fr 60px;gap:10px;align-items:center;margin:7px 0;font-size:14px;cursor:pointer}
.bar .lbl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.track{background:#eef1f5;border-radius:6px;height:14px;overflow:hidden}
.fill{height:100%;border-radius:6px}.bar .n{text-align:right;font-variant-numeric:tabular-nums;color:var(--mut)}
.bar:hover .lbl{text-decoration:underline}
.pill{display:inline-block;font-size:12px;padding:2px 8px;border-radius:999px;color:#fff;white-space:nowrap}
.S{background:var(--S)}.N{background:var(--N)}.E{background:var(--E)}.EX{background:var(--EX)}.X{background:var(--X)}.U{background:var(--U)}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}
input,select{font:inherit;padding:8px 10px;border:1px solid #c8cfda;border-radius:8px;background:#fff;color:var(--ink)}
input{min-width:240px}
.tw{overflow-x:auto;background:var(--card);border:1px solid var(--line);border-radius:10px}
table{border-collapse:collapse;width:100%;font-size:14px}th,td{text-align:left;padding:9px 11px;border-bottom:1px solid #eef0f4;white-space:nowrap}
th{background:#f1f4f8;cursor:pointer;user-select:none;position:sticky;top:0}th .ar{color:var(--acc);font-size:11px}
tr:hover td{background:#fafbfd}td.num{text-align:right;font-variant-numeric:tabular-nums}
.count{color:var(--mut);font-size:13px;margin:8px 2px}
.pager{display:flex;gap:8px;align-items:center;margin-top:10px;font-size:14px}
.pager button{font:inherit;padding:6px 12px;border:1px solid #c8cfda;background:#fff;border-radius:8px;cursor:pointer}
.pager button:disabled{opacity:.4;cursor:default}
ul.notes li{margin:6px 0}.legend{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 14px}
.muted{color:var(--mut)}
footer{color:var(--mut);font-size:12px;text-align:center;padding:20px}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style></head>
<body>
<header><h1>All Versions Lifecycle Dashboard</h1><p>Operating system and product release cycles | Reference date: 20 October 2026 | Source: all_versions.xlsx (Summary plus 63 product sheets)</p></header>
<nav role="tablist" aria-label="Dashboard sections">
<button role="tab" aria-selected="true" aria-controls="ov" id="t-ov" data-tab="ov">Overview</button>
<button role="tab" aria-selected="false" aria-controls="ex" id="t-ex" data-tab="ex">All cycles</button>
<button role="tab" aria-selected="false" aria-controls="bp" id="t-bp" data-tab="bp">By product</button>
<button role="tab" aria-selected="false" aria-controls="pit" id="t-pit" data-tab="pit">Point in time</button>
<button role="tab" aria-selected="false" aria-controls="so" id="t-so" data-tab="so">Ending within 12 months</button>
<button role="tab" aria-selected="false" aria-controls="tl" id="t-tl" data-tab="tl">EOL timeline</button>
<button role="tab" aria-selected="false" aria-controls="rc" id="t-rc" data-tab="rc">Supported check</button>
<button role="tab" aria-selected="false" aria-controls="me" id="t-me" data-tab="me">Method and checks</button>
</nav>
<main>
<section id="ov" class="on" role="tabpanel" aria-labelledby="t-ov">
  <h2>Overview</h2>
  <p class="sub">All 1,150 release cycles across 63 products. Select a status bar to see its cycles.</p>
  <div class="kpis">
    <div class="kpi"><b id="kTot">0</b><span>Release cycles</span></div>
    <div class="kpi"><b id="kProd">0</b><span>Products</span></div>
    <div class="kpi"><b id="kSup">0</b><span>Supported (all types)</span></div>
    <div class="kpi"><b id="kSoon">0</b><span>Ending within 12 months</span></div>
    <div class="kpi"><b id="kUns">0</b><span>Unsupported (incl. extended support)</span></div>
  </div>
  <div class="grid2">
    <div class="card"><h2>Cycles by status</h2><p class="sub" style="margin-bottom:10px">Click a row to filter All cycles.</p><div id="statusBars"></div></div>
    <div class="card"><h2>Products with most cycles ending within 12 months</h2><p class="sub" style="margin-bottom:10px">Click a product to view its cycles.</p><div id="prodBars"></div></div>
  </div>
</section>

<section id="ex" role="tabpanel" aria-labelledby="t-ex">
  <h2>All cycles</h2>
  <p class="sub">Search, filter by product or status, and sort by any column header.</p>
  <div class="toolbar">
    <input id="eSearch" type="search" placeholder="Search product, cycle or codename" aria-label="Search">
    <select id="eOS" aria-label="Filter by product"></select>
    <select id="eStatus" aria-label="Filter by status"></select>
  </div>
  <div class="tw"><table><thead><tr id="thead"></tr></thead><tbody id="tbody"></tbody></table></div>
  <div class="pager"><button id="prev">Previous</button><span id="pinfo"></span><button id="next">Next</button></div>
  <div class="count" id="ecount"></div>
<div class="card" style="margin-top:14px;font-size:14px"><b>Note Comment</b>
<ul class="notes" style="margin:6px 0 0 18px;padding:0">
<li>(E) = Enterprise, Education and IoT Enterprise editions</li>
<li>(W) = Home, Professional, Professional Education and Professional for Workstations editions</li>
<li>LTS = Long-Term Servicing Channel/Branch</li></ul></div>

</section>

<section id="so" role="tabpanel" aria-labelledby="t-so">
  <h2>Ending within 12 months</h2>
  <p class="sub">Supported cycles whose end-of-life date falls between 20 Oct 2026 and 20 Oct 2027, soonest first.</p>
  <div class="tw"><table><thead><tr><th>Product</th><th>Cycle</th><th>Codename</th><th>Support ends</th><th>End of life</th><th>Latest</th></tr></thead><tbody id="soonBody"></tbody></table></div>
</section>

<section id="me" role="tabpanel" aria-labelledby="t-me">
  <h2>Method and checks</h2>
  <p class="sub">How the statuses were calculated and what was reconciled.</p>
  <div class="card">
    <div class="legend">
      <span class="pill S">Supported</span><span class="pill N">Supported (no EOL date)</span><span class="pill E">Ending within 12 months</span><span class="pill EX">Extended support</span><span class="pill X">Unsupported (EOL passed)</span><span class="pill U">Unsupported (no EOL date)</span>
    </div>
    <ul class="notes">
      <li><b>Supported:</b> end-of-life date is more than 12 months away.</li>
      <li><b>Supported (no EOL date):</b> marked as supported in the source, with no end-of-life date recorded.</li>
      <li><b>Ending within 12 months:</b> end-of-life date falls between 20 Oct 2026 and 20 Oct 2027.</li>
      <li><b>Extended support:</b> the standard end-of-life date has passed, but an extended support date is still in the future. These cycles are marked unsupported in the source.</li>
      <li><b>Unsupported (EOL passed):</b> end-of-life date is on or before 20 Oct 2026, with no later extended support date.</li>
      <li><b>Unsupported (no EOL date):</b> marked as unsupported in the source, with no end-of-life date recorded.</li>
      <li><b>Note Comment (Windows):</b> (E) = Enterprise, Education and IoT Enterprise editions; (W) = Home, Professional, Professional Education and Professional for Workstations editions; LTS = Long-Term Servicing Channel/Branch.</li>
      <li><b>Checks:</b> the Summary sheet reconciles exactly with the 63 detailed sheets. The 172 cycles marked Supported in the source match the Supported Versions workbook. OpenBSD 7.8 has an end-of-life date of 20 Oct 2026 (today) and is treated as Supported.</li>
    </ul>
  </div>
</section>
<!--TL-START-->
<section id="tl" role="tabpanel" aria-labelledby="t-tl">
  <h2>End-of-life timeline</h2>
  <p class="sub">Number of release cycles reaching standard end-of-life, by year and month. Based on the end-of-life date for each cycle. Extended support dates are not included.</p>
  <div class="card" style="margin-bottom:16px">
    <h2 style="font-size:16px">Cycles reaching end of life per year, 2026 to 2035 (from October 2026)</h2>
    <p class="sub" style="margin-bottom:8px">Select a year to see its months. 2026 covers October to December only.</p>
    <div style="overflow-x:auto;padding-bottom:6px"><div id="tlChart" style="display:flex;align-items:flex-end;gap:4px;height:230px;min-width:900px;border-bottom:1px solid var(--line);padding-top:20px"></div>
    <div id="tlLabels" style="display:flex;gap:4px;min-width:900px;font-size:11px;color:var(--mut)"></div></div>
  </div>
  <div class="toolbar">
    <label for="tlYear" class="muted" style="align-self:center">Year</label>
    <select id="tlYear" aria-label="Select year"></select>
    <span class="muted" id="tlYearTotal" style="align-self:center"></span>
  </div>
  <div class="tw"><table><thead><tr><th>Month</th><th class="num">Cycles reaching EOL</th><th>Products and cycles</th></tr></thead><tbody id="tlBody"></tbody></table></div>
</section>
<script>
const TL = {"2026": {"10": [{"os": "KDE Plasma", "cycle": "6.7", "status": "Unsupported (EOL passed)"}, {"os": "Nutanix AOS", "cycle": "6.1", "status": "Ending within 12 months"}, {"os": "OpenBSD", "cycle": "7.8", "status": "Supported"}, {"os": "Windows", "cycle": "11-24h2-w", "status": "Unsupported (EOL passed)"}, {"os": "Windows", "cycle": "10-1607-e-lts", "status": "Extended support"}], "11": [{"os": "AIX", "cycle": "7.3.2", "status": "Ending within 12 months"}, {"os": "Alpine Linux", "cycle": "3.21", "status": "Ending within 12 months"}, {"os": "Windows", "cycle": "11-23h2-e", "status": "Ending within 12 months"}], "12": [{"os": "Fedora", "cycle": "43", "status": "Ending within 12 months"}, {"os": "FreeBSD", "cycle": "14.4", "status": "Ending within 12 months"}, {"os": "Linux Kernel", "cycle": "5.15", "status": "Ending within 12 months"}, {"os": "Linux Kernel", "cycle": "5.1", "status": "Ending within 12 months"}, {"os": "NixOS", "cycle": "26.05", "status": "Ending within 12 months"}, {"os": "Nutanix AOS", "cycle": "7.0", "status": "Ending within 12 months"}]}, "2027": {"1": [{"os": "NetApp ONTAP", "cycle": "9.14.1", "status": "Ending within 12 months"}, {"os": "postmarketOS", "cycle": "26.06", "status": "Ending within 12 months"}, {"os": "Windows", "cycle": "10-21h2-e-lts", "status": "Ending within 12 months"}, {"os": "Windows Server", "cycle": "2016", "status": "Ending within 12 months"}, {"os": "Windows Server Core", "cycle": "2016", "status": "Ending within 12 months"}], "3": [{"os": "F5 BIG-IP", "cycle": "17.1", "status": "Ending within 12 months"}, {"os": "Container-Optimized OS", "cycle": "cos-121", "status": "Ending within 12 months"}, {"os": "FreeBSD", "cycle": "15.1", "status": "Ending within 12 months"}], "4": [{"os": "Linux Mint", "cycle": "21.3", "status": "Ending within 12 months"}, {"os": "Linux Mint", "cycle": "21.2", "status": "Ending within 12 months"}, {"os": "Linux Mint", "cycle": "21.1", "status": "Ending within 12 months"}, {"os": "Linux Mint", "cycle": "21", "status": "Ending within 12 months"}, {"os": "Pop!_OS", "cycle": "22.04", "status": "Ending within 12 months"}], "5": [{"os": "Alpine Linux", "cycle": "3.22", "status": "Ending within 12 months"}, {"os": "CentOS Stream", "cycle": "9", "status": "Ending within 12 months"}, {"os": "PAN-OS", "cycle": "11.2", "status": "Ending within 12 months"}, {"os": "PAN-OS", "cycle": "11.1", "status": "Ending within 12 months"}], "6": [{"os": "Fedora", "cycle": "44", "status": "Ending within 12 months"}, {"os": "FreeBSD", "cycle": "14.5", "status": "Ending within 12 months"}, {"os": "Nutanix AOS", "cycle": "7.3", "status": "Ending within 12 months"}, {"os": "OpenBSD", "cycle": "7.9", "status": "Ending within 12 months"}, {"os": "Ubuntu", "cycle": "22.04", "status": "Ending within 12 months"}], "7": [{"os": "NetApp ONTAP", "cycle": "9.15.1", "status": "Ending within 12 months"}, {"os": "Ubuntu", "cycle": "26.1", "status": "Ending within 12 months"}], "9": [{"os": "Cisco IOS XE", "cycle": "17.12", "status": "Ending within 12 months"}, {"os": "VMware ESXi", "cycle": "9.0", "status": "Ending within 12 months"}], "10": [{"os": "VMware ESXi", "cycle": "8.0", "status": "Ending within 12 months"}, {"os": "openSUSE", "cycle": "16.0", "status": "Supported"}, {"os": "Photon OS", "cycle": "4.0", "status": "Ending within 12 months"}, {"os": "Windows", "cycle": "11-25h2-w", "status": "Ending within 12 months"}, {"os": "Windows", "cycle": "11-24h2-e", "status": "Ending within 12 months"}], "11": [{"os": "Alpine Linux", "cycle": "3.23", "status": "Supported"}, {"os": "OpenBSD", "cycle": "8.0", "status": "Supported"}, {"os": "SLES", "cycle": "16.0", "status": "Supported"}], "12": [{"os": "AIX", "cycle": "7.3.3", "status": "Supported"}, {"os": "Linux Kernel", "cycle": "6.6", "status": "Supported"}, {"os": "Linux Kernel", "cycle": "6.1", "status": "Supported"}, {"os": "Nutanix AOS", "cycle": "7.5", "status": "Supported"}]}, "2028": {"2": [{"os": "Container-Optimized OS", "cycle": "cos-125", "status": "Supported"}, {"os": "NetApp ONTAP", "cycle": "9.16.1", "status": "Supported"}], "3": [{"os": "Mageia", "cycle": "10", "status": "Supported"}, {"os": "Windows", "cycle": "11-26h1-w", "status": "Supported"}], "4": [{"os": "Yocto Project", "cycle": "5.0", "status": "Supported"}], "6": [{"os": "Alpine Linux", "cycle": "3.24", "status": "Supported"}, {"os": "antiX", "cycle": "23", "status": "Supported"}, {"os": "Debian", "cycle": "12.0", "status": "Supported"}, {"os": "Devuan", "cycle": "5", "status": "Supported"}, {"os": "MX Linux", "cycle": "23", "status": "Supported"}], "7": [{"os": "Container-Optimized OS", "cycle": "cos-129", "status": "Supported"}, {"os": "Nutanix AOS", "cycle": "7.6", "status": "Supported"}], "8": [{"os": "VMware ESXi", "cycle": "9.1", "status": "Supported"}, {"os": "PAN-OS", "cycle": "12.1", "status": "Supported"}], "9": [{"os": "Cisco IOS XE", "cycle": "17.15", "status": "Supported"}, {"os": "NetApp ONTAP", "cycle": "9.17.1", "status": "Supported"}], "10": [{"os": "Windows", "cycle": "11-26h2-w", "status": "Supported"}, {"os": "Windows", "cycle": "11-25h2-e", "status": "Supported"}], "11": [{"os": "Container-Optimized OS", "cycle": "cos-133", "status": "Supported"}, {"os": "FortiOS", "cycle": "7.4", "status": "Supported"}, {"os": "FreeBSD", "cycle": "14.0", "status": "Supported"}, {"os": "XCP-ng", "cycle": "8.3", "status": "Supported"}], "12": [{"os": "AIX", "cycle": "7.3.4", "status": "Supported"}, {"os": "Linux Kernel", "cycle": "6.18", "status": "Supported"}, {"os": "Linux Kernel", "cycle": "6.12", "status": "Supported"}]}, "2029": {"1": [{"os": "F5 BIG-IP", "cycle": "17.5", "status": "Supported"}, {"os": "NetApp ONTAP", "cycle": "9.18.1", "status": "Supported"}, {"os": "Windows", "cycle": "10-1809-e-lts", "status": "Supported"}, {"os": "Windows Server", "cycle": "2019", "status": "Supported"}, {"os": "Windows Server Core", "cycle": "2019", "status": "Supported"}], "3": [{"os": "Windows", "cycle": "11-26h1-e", "status": "Supported"}], "4": [{"os": "Linux Mint", "cycle": "22.3", "status": "Supported"}, {"os": "Linux Mint", "cycle": "22.2", "status": "Supported"}, {"os": "Linux Mint", "cycle": "22.1", "status": "Supported"}, {"os": "Linux Mint", "cycle": "22", "status": "Supported"}], "5": [{"os": "AlmaLinux", "cycle": "8", "status": "Supported"}, {"os": "F5 BIG-IP", "cycle": "21.1", "status": "Supported"}, {"os": "Pop!_OS", "cycle": "24.04", "status": "Supported"}, {"os": "RHEL", "cycle": "8", "status": "Supported"}, {"os": "Rocky Linux", "cycle": "8", "status": "Supported"}, {"os": "Ubuntu", "cycle": "24.04", "status": "Supported"}], "6": [{"os": "Amazon Linux", "cycle": "2023.0", "status": "Supported"}], "7": [{"os": "NetApp ONTAP", "cycle": "9.19.1", "status": "Supported"}, {"os": "Oracle Linux", "cycle": "8", "status": "Supported"}, {"os": "PAN-OS", "cycle": "12.2", "status": "Supported"}], "8": [{"os": "Cisco IOS XE", "cycle": "17.18", "status": "Supported"}, {"os": "KDE Plasma", "cycle": "6.6", "status": "Supported"}], "10": [{"os": "Windows", "cycle": "11-26h2-e", "status": "Supported"}, {"os": "Windows", "cycle": "11-24h2-e-lts", "status": "Supported"}], "12": [{"os": "FreeBSD", "cycle": "15.0", "status": "Supported"}]}, "2030": {"1": [{"os": "FortiOS", "cycle": "7.6", "status": "Supported"}], "4": [{"os": "Yocto Project", "cycle": "6.0", "status": "Supported"}], "5": [{"os": "CentOS Stream", "cycle": "10", "status": "Supported"}], "6": [{"os": "Debian", "cycle": "13.0", "status": "Supported"}, {"os": "Devuan", "cycle": "6", "status": "Supported"}, {"os": "MX Linux", "cycle": "25", "status": "Supported"}], "7": [{"os": "antiX", "cycle": "26", "status": "Supported"}], "10": [{"os": "FortiOS", "cycle": "8.0", "status": "Supported"}]}, "2031": {"5": [{"os": "Ubuntu", "cycle": "26.04", "status": "Supported"}], "7": [{"os": "SLES", "cycle": "15.7", "status": "Supported"}], "10": [{"os": "Windows Server", "cycle": "2022", "status": "Supported"}, {"os": "Windows Server Core", "cycle": "2022", "status": "Supported"}], "11": [{"os": "Solaris", "cycle": "11.4", "status": "Supported"}]}, "2032": {"1": [{"os": "Windows", "cycle": "10-21h2-iot-lts", "status": "Supported"}], "5": [{"os": "AlmaLinux", "cycle": "9", "status": "Supported"}, {"os": "RHEL", "cycle": "9", "status": "Supported"}, {"os": "Rocky Linux", "cycle": "9", "status": "Supported"}], "6": [{"os": "Oracle Linux", "cycle": "9", "status": "Supported"}]}, "2034": {"10": [{"os": "Windows", "cycle": "11-24h2-iot-lts", "status": "Supported"}, {"os": "Windows Server Core", "cycle": "2025", "status": "Supported"}], "11": [{"os": "Windows Server", "cycle": "2025", "status": "Supported"}]}, "2035": {"5": [{"os": "AlmaLinux", "cycle": "10", "status": "Supported"}, {"os": "RHEL", "cycle": "10", "status": "Supported"}, {"os": "Rocky Linux", "cycle": "10", "status": "Supported"}], "6": [{"os": "Oracle Linux", "cycle": "10", "status": "Supported"}]}};
(function(){
  const MN=["January","February","March","April","May","June","July","August","September","October","November","December"];
  const yrs=[];for(let y=2026;y<=2035;y++)yrs.push(y);
  const tot=y=>{const d=TL[String(y)]||{};return Object.values(d).reduce((a,v)=>a+v.length,0);};
  const mx=Math.max(...yrs.map(tot));
  const chart=document.getElementById('tlChart'),labels=document.getElementById('tlLabels');
  chart.innerHTML=yrs.map(y=>{const n=tot(y);const h=n/mx*180;const fut=false;
    return `<button type="button" data-y="${y}" title="${y}: ${n} cycles" aria-label="${y}: ${n} cycles reach end of life" style="flex:1;min-width:16px;height:${Math.max(h,n?3:0)}px;background:${fut?'var(--EX)':'var(--acc)'};border:0;border-radius:4px 4px 0 0;padding:0;cursor:pointer;position:relative" class="tlb"><span style="position:absolute;top:-18px;left:0;right:0;text-align:center;font-size:11px;color:var(--mut)">${n||''}</span></button>`;}).join('');
  labels.innerHTML=yrs.map(y=>`<div style="flex:1;min-width:16px;text-align:center">${y%2===0||y===2026?y:''}</div>`).join('');
  const sel=document.getElementById('tlYear');
  sel.innerHTML=yrs.slice().reverse().map(y=>`<option value="${y}">${y} (${tot(y)} cycles)</option>`).join('');
  sel.value='2026';
  function render(){
    const y=sel.value,d=TL[y]||{};
    document.getElementById('tlYearTotal').textContent=tot(+y)+' cycles reach end of life in '+y;
    document.getElementById('tlBody').innerHTML=MN.map((name,i)=>{
      const list=d[String(i+1)]||[];
      if(+y===2026&&i<9)return '';
      const items=list.map(x=>`${escp(x.os)} ${escp(x.cycle)}`).join(', ');
      return `<tr><td>${name}</td><td class="num">${list.length}</td><td style="white-space:normal">${items||'<span class="muted">None</span>'}</td></tr>`;
    }).join('');
  }
  const escp=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  chart.querySelectorAll('.tlb').forEach(b=>b.addEventListener('click',()=>{sel.value=b.dataset.y;render();}));
  sel.addEventListener('change',render);
  render();
})();
</script>
</section>
